{
    "plugins": [],
    "source": {
        "include": ["script"],
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "(^|\\/|\\\\)_"
    },
    "sourceType": "module",
    "tags": {
        "allowUnknownTags": true,
        "dictionaries": ["jsdoc", "closure"]
    },
    "opts": {
        "destination": "./out",
        "recurse": true
    },
    "templates": {
        "cleansed": true,
        "chroma": "autumn"
    }
}